        "asb-cli_src_collectors_adapters_pidstat_Samples" [label="{collectors_adapters_pidstat_Samples|+series: BTreeMap\<String, Vec\<f64\>\>\l+timestamps: BTreeMap\<String, Vec\<f64\>\>\l}", shape=record];
