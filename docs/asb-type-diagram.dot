        "asb-cli_src_collectors_adapters_perfetto_Daemons" [label="{collectors_adapters_perfetto_Daemons|-children: Arc\<Mutex\<Vec\<Child\>\>\>\l-readers: Vec\<std::thread::JoinHandle\<()\>\>\l|+start(command: Command, log_path: &Path) cassette_Result\<(), String\>\l+check_alive() cassette_Result\<(), String\>\l}", shape=record];
        "asb-cli_src_collectors_adapters_perfetto_Drop" [label="{collectors_adapters_perfetto_Drop||+drop() void\l+drop() void\l}", shape=record];
