        "asb-cli_src_workloads_adapters_WorkloadAdapter" [label="{workloads_adapters_WorkloadAdapter||+id() &'static str\l+trial_ids() Vec\<workloads_Trial\>\l+prepare_source(workloads: &Path, workspace: &Path) Result\<usize, String\>\l+id() &'static str\l+matches(name: &str) bool\l+trial_ids() Vec\<workloads_Trial\>\l+populate_prompts(directory: &Path) Result\<usize, std::io::Error\>\l+populate_fixtures(directory: &Path) Result\<usize, std::io::Error\>\l+prepare_fixture(name: &str, workspace: &Path) Result\<usize, String\>\l+prepare_source(_workloads: &Path, _workspace: &Path) Result\<usize, String\>\l}", shape=record];
