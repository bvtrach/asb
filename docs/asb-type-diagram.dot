    subgraph "cluster_compare" {
        label="compare";
        color="#cbd5e1";
        fontcolor="#334155";
        style="rounded,dashed";
        "asb-cli_src_BenchmarkData" [label="{BenchmarkData|-result_source: &'static str\l-reconciled: bool\l-replica_index: Option\<usize\>\l-execution_cohort: Option\<crate::measurements::ExecutionCohort\>\l-label: String\l-directory: PathBuf\l-agent: String\l-workload: String\l-task: Option\<crate::workloads::TaskIdentity\>\l-selection: Option\<crate::workloads::TaskSelection\>\l-evaluation_completed: bool\l-workload_evaluation: String\l-provider: String\l-model: String\l-metrics: BTreeMap\<String, f64\>\l-series: BTreeMap\<String, TimeSeries\>\l-host_metadata: Option\<Value\>\l-components: Option\<Value\>\l-status: Option\<String\>\l-artifacts: Vec\<String\>\l}", shape=record];
        "asb-cli_src_compare_EvaluationCoverage" [label="{compare_EvaluationCoverage|+selected_attempts: usize\l+eligible_selected_attempts: usize\l+evaluated_attempts: usize\l+unevaluated_attempts: usize\l+unscored_attempts: usize\l}", shape=record];
        "asb-cli_src_compare_PopulationCoverage" [label="{compare_PopulationCoverage|-label: String\l-selected_attempts: usize\l-evaluated_attempts: usize\l-resolved_attempts: usize\l-selected_tasks: usize\l-evaluated_tasks: usize\l-resolved_tasks: usize\l-population_size: usize\l-selection_coverage: f64\l-evaluation_coverage: f64\l-selected_resolution_lower_bound: f64\l-complete_population_evaluation: bool\l-full_population_resolution_rate: Option\<f64\>\l-selected: BTreeSet\<String\>\l-evaluated: BTreeSet\<String\>\l-resolved: BTreeSet\<String\>\l|+observe(task: &str, population: usize, evaluated: bool, resolved: bool) cassette_Result\<(), Error\>\l}", shape=record];
        "asb-cli_src_compare_Recorded" [label="{compare_Recorded|+path: PathBuf\l+summary: Value\l-workload_cleanup: bool\l-proxy_cleanup: bool\l+source: &'static str\l|+check_measurement(measured: &Value) cassette_Result\<(), Error\>\l+status() String\l}", shape=record];
    }

    subgraph "cluster_core" {
