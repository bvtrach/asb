    subgraph "cluster_proxy" {
        label="proxy";
        color="#cbd5e1";
        fontcolor="#334155";
        style="rounded,dashed";
        "asb-cli_src_proxy_Chain" [label="{proxy_Chain|-hops: Vec\<Box\<dyn ProxySession\>\>\l-url: String\l|+start(names: &[String], upstream: Option\<&str\>, configurations: &HashMap\<String, Box\<dyn Any\>\>) Result\<Self, Error\>\l+start_selected(selected: &[&dyn ProxyAdapter], upstream: Option\<&str\>, configurations: &HashMap\<String, Box\<dyn Any\>\>) Result\<Self, Error\>\l+url() &str\l+stop(self) Result\<(), Error\>\l}", shape=record];
        "asb-cli_src_proxy_Drop" [label="{proxy_Drop||+drop() void\l}", shape=record];
