digraph ASB_Rust_UML {
    graph [bgcolor="white", compound=true, fontname="Helvetica", fontsize=18, label="ASB Rust architecture", labelloc=t, newrank=true, nodesep=0.35, pad=0.25, rankdir=LR, ranksep=1.15, splines=polyline];
    node [color="#64748b", fillcolor="#f8fafc", fontname="Helvetica", fontsize=9, shape=record, style="filled,rounded"];
    edge [color="#94a3b8", fontname="Helvetica", fontsize=8, arrowsize=0.7];

    subgraph "cluster_agents" {
        label="agents";
        color="#cbd5e1";
        fontcolor="#334155";
        style="rounded,dashed";
        "asb-cli_src_agents_AgentAdapter" [label="{agents_AgentAdapter||+id() &'static str\l+executable() &'static str\l+recipe() Recipe\l+supported_endpoints() &'static [Support]\l+command(context: &CommandContext\<'_\>) agents_CommandSpec\l+prepare(context: &mut PreparationContext\<'_\>) Result\<(), Error\>\l+replay_credential_vars() &'static [&'static str]\l+collect(context: &CollectionContext\<'_\>) agents_AgentArtifacts\l}", shape=record];
        "asb-cli_src_agents_AgentArtifacts" [label="{agents_AgentArtifacts|+token_usage: Option\<crate::measurements::TokenUsage\>\l+cleanup_paths: Vec\<PathBuf\>\l}", shape=record];
        "asb-cli_src_agents_CollectionContext" [label="{agents_CollectionContext|+workspace: &'a Path\l}", shape=record];
        "asb-cli_src_agents_CommandContext" [label="{agents_CommandContext|+config: &'a BenchmarkConfig\l+endpoint: Option\<&'a str\>\l+interface: Option\<Interface\>\l+prompt: &'a str\l}", shape=record];
        "asb-cli_src_agents_CommandSpec" [label="{agents_CommandSpec|+program: String\l+args: Vec\<String\>\l+append_prompt: bool\l}", shape=record];
        "asb-cli_src_agents_PreparationContext" [label="{agents_PreparationContext|+command: &'a mut Command\l+model: &'a str\l+connection: Connection\l+runtime_dir: &'a Path\l}", shape=record];
        "asb-cli_src_agents_StaticAdapter" [label="{agents_StaticAdapter|-id: &'static str\l-executable: &'static str\l-recipe: Recipe\l-supported_endpoints: &'static [Support]\l-command: CommandBuilder\l-prepare: PreparationHook\l-collect: Option\<CollectionHook\>\l-replay_credential_vars: &'static [&'static str]\l|+new(id: &'static str, executable: &'static str, recipe: Recipe, supported_endpoints: &'static [Support], command: CommandBuilder, prepare: PreparationHook) Self\l+with_collection(self, collect: CollectionHook) Self\l+with_replay_credential_vars(self, vars: &'static [&'static str]) Self\l}", shape=record];
    }

    subgraph "cluster_benchmark" {
        label="benchmark";
        color="#cbd5e1";
        fontcolor="#334155";
        style="rounded,dashed";
        "asb-cli_src_BenchmarkConfig" [label="{BenchmarkConfig|+agent: String\l+workload: String\l+provider: String\l+model: String\l+concurrency: usize\l+trial_set: Option\<String\>\l+trial: Option\<String\>\l+workspace: String\l+log_file: String\l+measurements: Option\<MeasurementConfig\>\l}", shape=record];
        "asb-cli_src_MeasurementConfig" [label="{MeasurementConfig|+enabled: bool\l+directory: String\l+collectors: Vec\<String\>\l}", shape=record];
    }

    subgraph "cluster_compare" {
        label="compare";
        color="#cbd5e1";
        fontcolor="#334155";
        style="rounded,dashed";
        "asb-cli_src_BenchmarkData" [label="{BenchmarkData|-label: String\l-directory: PathBuf\l-agent: String\l-workload: String\l-provider: String\l-model: String\l-metrics: BTreeMap\<String, f64\>\l-series: BTreeMap\<String, TimeSeries\>\l-status: Option\<String\>\l-artifacts: Vec\<String\>\l}", shape=record];
    }

    subgraph "cluster_core" {
        label="core";
        color="#cbd5e1";
        fontcolor="#334155";
        style="rounded,dashed";
        "asb-cli_src_BpftraceProfile" [label="{BpftraceProfile|-name: &'static str\l-description: &'static str\l-program: &'static str\l}", shape=record];
        "asb-cli_src_Cli" [label="{Cli|-completion: Option\<String\>\l-command: Option\<CommandLine\>\l}", shape=record];
        "asb-cli_src_CliError" [label="{CliError||+fmt(formatter: Formatter\<'_\>) Result\l}", shape=record];
        "asb-cli_src_CollectorAdapter" [label="{CollectorAdapter||+id() &'static str\l+environment_flag() Option\<&'static str\>\l+tool_id() Option\<&'static str\>\l+requires_pid() bool\l}", shape=record];
        "asb-cli_src_CompareArgs" [label="{CompareArgs|-path: String\l}", shape=record];
        "asb-cli_src_Connection" [label="{Connection|+interface: Interface\l+base_url: String\l+credential: Option\<String\>\l+authentication: Authentication\l}", shape=record];
        "asb-cli_src_Default" [label="{Default||+default() Self\l}", shape=record];
        "asb-cli_src_Drop" [label="{Drop||+drop() void\l}", shape=record];
        "asb-cli_src_From" [label="{From||+from(value: SetupArgs) Self\l+from(value: ModelArgs) Self\l+from(value: ToolInstallArgs) Self\l+from(value: WorkloadInstallArgs) Self\l+from(value: WorkloadListArgs) Self\l}", shape=record];
        "asb-cli_src_InitArgs" [label="{InitArgs|-root: Option\<PathBuf\>\l-reset: bool\l}", shape=record];
        "asb-cli_src_ModelArgs" [label="{ModelArgs|-provider: Option\<String\>\l-json: bool\l-free: bool\l}", shape=record];
        "asb-cli_src_ModelListOptions" [label="{ModelListOptions|+provider: Option\<String\>\l+json: bool\l+free_only: bool\l}", shape=record];
        "asb-cli_src_Offer" [label="{Offer|+interface: Interface\l+authentication: Authentication\l+address: Address\l}", shape=record];
        "asb-cli_src_OwnedChild" [label="{OwnedChild||+deref() Target\l+deref_mut() Target\l}", shape=record];
        "asb-cli_src_ProviderArgs" [label="{ProviderArgs|-command: ProviderCommand\l}", shape=record];
        "asb-cli_src_RunArgs" [label="{RunArgs|-path: String\l-record: bool\l-replay: bool\l-respect_record_timings: bool\l-cassette: Option\<String\>\l-json: bool\l-show_output: bool\l-measurements: Option\<String\>\l}", shape=record];
        "asb-cli_src_Session" [label="{Session|-dir: PathBuf\l-tool_dir: Option\<PathBuf\>\l-started_unix_ms: u128\l-collectors: Vec\<Collector\>\l-perf_data: Option\<PathBuf\>\l-perf_enabled: bool\l-perfetto_trace: Option\<PathBuf\>\l-perfetto_enabled: bool\l-trace_marker: Option\<PathBuf\>\l-tracepoint_count: u64\l-perfetto_metrics: BTreeMap\<String, f64\>\l-bpftrace_profiles: Vec\<BpftraceProfile\>\l-mpstat_enabled: bool\l-iostat_enabled: bool\l-bpftrace_enabled: bool\l-sudo_collectors: BTreeSet\<String\>\l|+started_unix_ms() u128\l+start_with_collectors(dir: &Path, selected: &[String], tool_dir: Option\<&Path\>) Result\<Self, String\>\l+trace_instant(name: &str) void\l+trace_begin(name: &str) void\l+trace_end() void\l+attach_pid(pid: u32) Result\<(), String\>\l+finish(self, measurement: RunMeasurement\<'a\>) Result\<(), String\>\l+start_perfetto(pid: u32) Result\<(), String\>\l+write_trace_marker(event: &str) void\l+perfetto_trace_metrics() BTreeMap\<String, f64\>\l+perfetto_trace_series() (BTreeMap\<String, Vec\<f64\>\>, BTreeMap\<String, Vec\<f64\>\>\l+start_snapshot(name: &str, variable: &str, args: &[&str], enabled: bool, command_name: &str) Result\<(), String\>\l+start_process_snapshots(pid: u32) Result\<(), String\>\l+start_bpftrace(pid: u32) Result\<(), String\>\l+start_bpftrace_profiles(pid: u32) Result\<(), String\>\l+write_flamegraph() Result\<(), String\>\l+command(name: &str) Command\l+executable(name: &str) PathBuf\l}", shape=record];
        "asb-cli_src_SetupArgs" [label="{SetupArgs|-mode: Option\<SetupMode\>\l-agent: Option\<String\>\l-workload: Option\<String\>\l-provider: Option\<String\>\l-model: Option\<String\>\l-concurrency: Option\<usize\>\l-workspace: Option\<String\>\l-output: Option\<String\>\l}", shape=record];
        "asb-cli_src_SetupOptions" [label="{SetupOptions|+agent: Option\<String\>\l+workload: Option\<String\>\l+provider: Option\<String\>\l+model: Option\<String\>\l+concurrency: Option\<usize\>\l+workspace: Option\<String\>\l+output: Option\<String\>\l}", shape=record];
        "asb-cli_src_StaticCollector" [label="{StaticCollector|-id: &'static str\l-environment_flag: Option\<&'static str\>\l-tool_id: Option\<&'static str\>\l-requires_pid: bool\l|+new(id: &'static str, environment_flag: Option\<&'static str\>, tool_id: Option\<&'static str\>, requires_pid: bool) Self\l}", shape=record];
        "asb-cli_src_Support" [label="{Support|+interface: Interface\l+authentication: &'static [Authentication]\l}", shape=record];
        "asb-cli_src_SweepArgs" [label="{SweepArgs|-path: String\l-record: bool\l-replay: bool\l-respect_record_timings: bool\l-json: bool\l-show_output: bool\l-cassette_root: Option\<String\>\l}", shape=record];
        "asb-cli_src_SweepFile" [label="{SweepFile|-configs: Vec\<String\>\l}", shape=record];
        "asb-cli_src_TimeSeries" [label="{TimeSeries|-values: Vec\<f64\>\l-timestamps_ms: Option\<Vec\<f64\>\>\l}", shape=record];
        "asb-cli_src_ToolArgs" [label="{ToolArgs|-command: ToolCommand\l}", shape=record];
        "asb-cli_src_ToolInstallArgs" [label="{ToolInstallArgs|-name: String\l-source: Option\<String\>\l-dir: Option\<PathBuf\>\l-dry_run: bool\l}", shape=record];
        "asb-cli_src_ToolInstallOptions" [label="{ToolInstallOptions|+name: String\l+source: Option\<String\>\l+dir: Option\<PathBuf\>\l+dry_run: bool\l}", shape=record];
        "asb-cli_src_ToolListArgs" [label="{ToolListArgs}", shape=record];
        "asb-cli_src_WorkloadArgs" [label="{WorkloadArgs|-command: WorkloadCommand\l}", shape=record];
        "asb-cli_src_WorkloadInstallArgs" [label="{WorkloadInstallArgs|-source: String\l-name: Option\<String\>\l-dir: Option\<PathBuf\>\l}", shape=record];
        "asb-cli_src_WorkloadInstallOptions" [label="{WorkloadInstallOptions|+source: String\l+name: Option\<String\>\l+dir: Option\<PathBuf\>\l}", shape=record];
        "asb-cli_src_WorkloadListArgs" [label="{WorkloadListArgs|-dir: Option\<PathBuf\>\l}", shape=record];
        "asb-cli_src_WorkloadListOptions" [label="{WorkloadListOptions|+dir: Option\<PathBuf\>\l}", shape=record];
        "asb-cli_tests_Drop" [label="{asb-cli_tests_Drop||+drop() void\l+drop() void\l}", shape=record];
        "asb-cli_tests_MockProvider" [label="{asb-cli_tests_MockProvider|-endpoint: String\l-requests: Arc\<Mutex\<Vec\<String\>\>\>\l-done: Arc\<AtomicBool\>\l-thread: Option\<std::thread::JoinHandle\<()\>\>\l|+start() Self\l}", shape=record];
        "asb-cli_tests_Project" [label="{asb-cli_tests_Project||+new() Self\l+command(args: &[&str]) Output\l+command_with_env(args: &[&str], extra: &[(&str, &str)]) Output\l+write(name: &str, contents: &str) void\l+init() void\l}", shape=record];
        "asb-cli_tests_WaitForFixtureExpiry" [label="{asb-cli_tests_WaitForFixtureExpiry|-pid: u32\l-executable: PathBuf\l}", shape=record];
        "tests_asb-cli_src_FailingWriter" [label="{tests_FailingWriter||+write() Result\<usize\>\l+flush() Result\<()\>\l}", shape=record];
        "tests_asb-cli_src_proxy_FixtureAdapter" [label="{tests_proxy_FixtureAdapter|-name: &'static str\l-fail: bool\l-fail_finish: bool\l-events: Arc\<Mutex\<Vec\<String\>\>\>\l}", shape=record];
        "tests_asb-cli_src_proxy_FixtureSession" [label="{tests_proxy_FixtureSession|-name: &'static str\l-url: String\l-active: bool\l-fail_finish: bool\l-events: Arc\<Mutex\<Vec\<String\>\>\>\l}", shape=record];
        "tests_asb-cli_src_proxy_ProxyAdapter" [label="{tests_proxy_ProxyAdapter||+name() &'static str\l+start(upstream: Option\<&str\>, settings: Option\<&dyn Any\>) Result\<Box\<dyn ProxySession\>, Error\>\l}", shape=record];
        "tests_asb-cli_src_proxy_ProxySession" [label="{tests_proxy_ProxySession||+url() &str\l+finish() Result\<(), Error\>\l+abort() void\l}", shape=record];
    }

    subgraph "cluster_install" {
        label="install";
        color="#cbd5e1";
        fontcolor="#334155";
        style="rounded,dashed";
        "asb-cli_src_BundleSpec" [label="{BundleSpec|-archive: &'static str\l-marker: &'static str\l-prompt: &'static str\l}", shape=record];
        "asb-cli_src_ExternalWorkload" [label="{ExternalWorkload|-name: &'static str\l-source: &'static str\l}", shape=record];
        "asb-cli_src_LoggedStatus" [label="{LoggedStatus||+logged_status() Result\<ExitStatus\>\l}", shape=record];
    }

    subgraph "cluster_measurements" {
        label="measurements";
        color="#cbd5e1";
        fontcolor="#334155";
        style="rounded,dashed";
        "asb-cli_src_Collector" [label="{Collector|-name: String\l-child: Child\l-started: Instant\l-stdout_path: PathBuf\l-stderr_path: PathBuf\l}", shape=record];
        "asb-cli_src_CollectorResult" [label="{CollectorResult|-schema_version: u32\l-collector: String\l-status: String\l-exit_code: Option\<i32\>\l-elapsed_ms: u128\l-stdout: String\l-stderr: String\l-artifact: Option\<String\>\l-metrics: BTreeMap\<String, f64\>\l-series: BTreeMap\<String, Vec\<f64\>\>\l-series_timestamps: BTreeMap\<String, Vec\<f64\>\>\l}", shape=record];
        "asb-cli_src_FlamegraphStatus" [label="{FlamegraphStatus|-schema_version: u32\l-status: &'a str\l-artifact: Option\<&'a str\>\l-reason: Option\<&'a str\>\l}", shape=record];
        "asb-cli_src_RunMeasurement" [label="{RunMeasurement|+schema_version: u32\l+run_id: String\l+status: &'a str\l+success: bool\l+success_rate: f64\l+agent: &'a str\l+workload: &'a str\l+provider: &'a str\l+model: &'a str\l+elapsed_ms: u128\l+exit_code: Option\<i32\>\l+token_usage: TokenUsage\l+steps: u64\l+started_unix_ms: u128\l}", shape=record];
        "asb-cli_src_SystemInfo" [label="{SystemInfo|-schema_version: u32\l-collected_unix_ms: u128\l-os: &'static str\l-architecture: &'static str\l-logical_cpus: usize\l-kernel_release: Option\<String\>\l-memory_total_kib: Option\<u64\>\l}", shape=record];
        "asb-cli_src_TokenUsage" [label="{TokenUsage|+input_tokens: Option\<u64\>\l+output_tokens: Option\<u64\>\l+cached_tokens: Option\<u64\>\l+total_tokens: Option\<u64\>\l+source: Option\<String\>\l|+merge(self, other: Self) Self\l+add(self, other: Self) Self\l+merge_with_source(self, other: Self, source: &str) Self\l+with_derived_total(self) Self\l+any() bool\l}", shape=record];
    }

    subgraph "cluster_models" {
        label="models";
        color="#cbd5e1";
        fontcolor="#334155";
        style="rounded,dashed";
        "asb-cli_src_ModelInfo" [label="{ModelInfo|-id: String\l-tool_calling: Option\<bool\>\l}", shape=record];
    }

    subgraph "cluster_project" {
