digraph ASB_Rust_UML {
    graph [bgcolor="white", compound=true, fontname="Helvetica", fontsize=18, label="ASB Rust architecture", labelloc=t, newrank=true, nodesep=0.35, pad=0.25, rankdir=LR, ranksep=1.15, splines=polyline];
    node [color="#64748b", fillcolor="#f8fafc", fontname="Helvetica", fontsize=9, shape=record, style="filled,rounded"];
    edge [color="#94a3b8", fontname="Helvetica", fontsize=8, arrowsize=0.7];

    subgraph "cluster_agents" {
        label="agents";
        color="#cbd5e1";
        fontcolor="#334155";
        style="rounded,dashed";
        "asb-cli_src_agents_AgentAdapter" [label="{agents_AgentAdapter||+id() &'static str\l+executable() &'static str\l+recipe() Recipe\l+supported_endpoints() &'static [Support]\l+command(context: &CommandContext\<'_\>) agents_CommandSpec\l+prepare(context: &mut PreparationContext\<'_\>) cassette_Result\<(), Error\>\l+process(executable: &str) cassette_Result\<Command, Error\>\l+replay_credential_vars() &'static [&'static str]\l+collect(context: &CollectionContext\<'_\>) agents_AgentArtifacts\l+output_usage(stdout: &str, stderr: &str, input_includes_cache: bool) Option\<crate::measurements::TokenUsage\>\l+final_response(output: &str, workspace: &Path) Option\<String\>\l+step_count(stdout: &str, stderr: &str) Option\<u64\>\l+execution_failure(stdout: &str, stderr: &str) Option\<String\>\l}", shape=record];
        "asb-cli_src_agents_AgentArtifacts" [label="{agents_AgentArtifacts|+token_usage: Option\<crate::measurements::TokenUsage\>\l+steps: Option\<u64\>\l+cleanup_paths: Vec\<PathBuf\>\l}", shape=record];
        "asb-cli_src_agents_CollectionContext" [label="{agents_CollectionContext|+workspace: &'a Path\l+run_dir: &'a Path\l+interface: Option\<Interface\>\l+anthropic_input_includes_cache: bool\l}", shape=record];
        "asb-cli_src_agents_CommandContext" [label="{agents_CommandContext|+config: &'a BenchmarkConfig\l+endpoint: Option\<&'a str\>\l+interface: Option\<Interface\>\l+prompt: &'a str\l}", shape=record];
        "asb-cli_src_agents_CommandSpec" [label="{agents_CommandSpec|+program: String\l+args: Vec\<String\>\l+append_prompt: bool\l}", shape=record];
        "asb-cli_src_agents_GuestRequest" [label="{agents_GuestRequest|+process_lifetime: ProcessLifetime\l+workload_owner: Option\<agents_WorkloadOwner\>\l+config: BenchmarkConfig\l+connection: Connection\l+prompt: String\l+project_root: PathBuf\l+runtime_dir: PathBuf\l+run_dir: PathBuf\l+replay: bool\l+timeout_seconds: f64\l+namespace_collectors: Vec\<String\>\l}", shape=record];
        "asb-cli_src_agents_GuestResult" [label="{agents_GuestResult|+elapsed_ms: Option\<u64\>\l+timed_out: bool\l+workload_owner: Option\<agents_WorkloadOwner\>\l+schema_version: u32\l+exit_code: Option\<i32\>\l+final_response: Option\<String\>\l+token_usage: collectors_adapters_TokenUsage\l+steps: Option\<u64\>\l+execution_failure: Option\<String\>\l+tree_quiesced: bool\l+namespace_collectors: BTreeMap\<String, serde_json::Value\>\l}", shape=record];
        "asb-cli_src_agents_PreparationContext" [label="{agents_PreparationContext|+command: &'a mut Command\l+model: &'a str\l+connection: Connection\l+runtime_dir: &'a Path\l+run_dir: &'a Path\l}", shape=record];
        "asb-cli_src_agents_StaticAdapter" [label="{agents_StaticAdapter|-id: &'static str\l-executable: &'static str\l-recipe: Recipe\l-supported_endpoints: &'static [Support]\l-command: CommandBuilder\l-prepare: PreparationHook\l-collect: Option\<CollectionHook\>\l-output_usage: Option\<UsageHook\>\l-final_response: Option\<FinalResponseHook\>\l-process: Option\<ProcessHook\>\l-step_count: Option\<StepCountHook\>\l-failure: Option\<FailureHook\>\l-replay_credential_vars: &'static [&'static str]\l|+new(id: &'static str, executable: &'static str, recipe: Recipe, supported_endpoints: &'static [Support], command: CommandBuilder, prepare: PreparationHook) Self\l+with_collection(self, collect: CollectionHook) Self\l+with_output_usage(self, hook: UsageHook) Self\l+with_step_count(self, hook: StepCountHook) Self\l+with_final_response(self, hook: FinalResponseHook) Self\l+with_execution_failure(self, hook: FailureHook) Self\l+with_process(self, hook: ProcessHook) Self\l+with_replay_credential_vars(self, vars: &'static [&'static str]) Self\l}", shape=record];
        "asb-cli_src_agents_WorkloadOwner" [label="{agents_WorkloadOwner|+controller_namespace: u64\l+guest_namespace: u64\l+token: String\l}", shape=record];
    }

    subgraph "cluster_benchmark" {
        label="benchmark";
        color="#cbd5e1";
        fontcolor="#334155";
        style="rounded,dashed";
        "asb-cli_src_BenchmarkConfig" [label="{BenchmarkConfig|+agent: String\l+workload: String\l+provider: String\l+model: String\l+concurrency: usize\l+trial_set: Option\<String\>\l+trial: Option\<String\>\l+workspace: String\l+log_file: String\l+measurements: Option\<MeasurementConfig\>\l}", shape=record];
        "asb-cli_src_MeasurementConfig" [label="{MeasurementConfig|+enabled: bool\l+directory: String\l+collectors: Vec\<String\>\l}", shape=record];
    }

    subgraph "cluster_collectors" {
        label="collectors";
        color="#cbd5e1";
        fontcolor="#334155";
        style="rounded,dashed";
        "asb-cli_src_collectors_GraphSection" [label="{collectors_GraphSection|+title: &'static str\l+description: &'static str\l}", shape=record];
        "asb-cli_src_collectors_LifecyclePhase" [label="{collectors_LifecyclePhase||+name(self) &'static str\l}", shape=record];
        "asb-cli_src_collectors_PreflightContext" [label="{collectors_PreflightContext|+measurement_dir: &'a Path\l+selected: &'a [String]\l+tool_dir: Option\<&'a Path\>\l+sudo_collectors: &'a mut BTreeSet\<String\>\l}", shape=record];
        "asb-cli_src_collectors_ProcessContext" [label="{collectors_ProcessContext|+name: &'a str\l+status: ExitStatus\l+stdout: &'a str\l+stderr: &'a str\l}", shape=record];
        "asb-cli_src_collectors_ProcessData" [label="{collectors_ProcessData|+status: String\l+metrics: BTreeMap\<String, f64\>\l+series: BTreeMap\<String, Vec\<f64\>\>\l+timestamps: BTreeMap\<String, Vec\<f64\>\>\l+artifact: Option\<String\>\l|+from_output(context: &ProcessContext\<'_\>) Self\l}", shape=record];
        "asb-cli_src_collectors_RunMetrics" [label="{collectors_RunMetrics|+elapsed_ms: u128\l+success_rate: f64\l}", shape=record];
        "asb-cli_src_collectors_RunObservation" [label="{collectors_RunObservation|+elapsed_ms: u128\l+success: bool\l}", shape=record];
        "asb-cli_src_collectors_UsageContext" [label="{collectors_UsageContext|+provider: &'a str\l+agent: &'a str\l+stdout: &'a str\l+stderr: &'a str\l+cassette: Option\<&'a Path\>\l}", shape=record];
        "asb-cli_src_collectors_adapters_AgentProcesses" [label="{collectors_adapters_AgentProcesses||+prefers_execution_namespace() bool\l+execution_namespace_requested(session: &mut Session) bool\l+export_execution_namespace_state(session: &mut Session) cassette_Result\<serde_json::Value, String\>\l+import_execution_namespace_state(session: &mut Session, value: Value) cassette_Result\<(), String\>\l+attach_isolated_pid(session: &mut Session, _pid: u32) cassette_Result\<(), String\>\l+id() &'static str\l+environment_flag() Option\<&'static str\>\l+requires_pid() bool\l+configure(session: &mut Session, selected: &[String]) cassette_Result\<(), String\>\l+agent_launch(session: &mut Session, program: &str, args: &[String]) void\l+agent_launch_prepared(session: &mut Session, command: Command) void\l+attach_pid(session: &mut Session, pid: u32) cassette_Result\<(), String\>\l+lifecycle_event(session: &mut Session, event: LifecycleEvent) cassette_Result\<(), String\>\l+finish(session: &mut Session) cassette_Result\<(), String\>\l+graph_section(name: &str) Option\<collectors_GraphSection\>\l}", shape=record];
        "asb-cli_src_collectors_adapters_BpftraceCollector" [label="{collectors_adapters_BpftraceCollector}", shape=record];
        "asb-cli_src_collectors_adapters_BpftraceProfile" [label="{collectors_adapters_BpftraceProfile|-name: &'static str\l-description: &'static str\l-program: &'static str\l-default_selection: bool\l}", shape=record];
        "asb-cli_src_collectors_adapters_BpftraceState" [label="{collectors_adapters_BpftraceState|-enabled: bool\l-profiles: Vec\<collectors_adapters_BpftraceProfile\>\l}", shape=record];
        "asb-cli_src_collectors_CollectorAdapter" [label="{collectors_CollectorAdapter||+id() &'static str\l+tool_id() Option\<&'static str\>\l+requires_pid() bool\l+dependencies() &'static [&'static str]\l+preflight(context: collectors_PreflightContext\<'_\>) cassette_Result\<(), String\>\l+prioritizes_artifact(name: &str) bool\l+display_artifact(name: &str) Option\<ArtifactDisplay\>\l+finish(session: Session) cassette_Result\<(), String\>\l}", shape=record];
        "asb-cli_src_collectors_adapters_CpuAccounting" [label="{collectors_adapters_CpuAccounting}", shape=record];
        "asb-cli_src_collectors_adapters_CpuIdentity" [label="{collectors_adapters_CpuIdentity|-model: Option\<String\>\l-vendor: Option\<String\>\l-implementer: Option\<String\>\l-part: Option\<String\>\l}", shape=record];
        "asb-cli_src_collectors_adapters_CpuState" [label="{collectors_adapters_CpuState|-enabled: bool\l}", shape=record];
        "asb-cli_src_collectors_adapters_Drop" [label="{collectors_adapters_Drop||+drop() void\l}", shape=record];
        "asb-cli_src_collectors_adapters_ExternalCounter" [label="{collectors_adapters_ExternalCounter|-path: PathBuf\l-initial: (u64, u64)\l-final_delta: Option\<(u64, u64)\>\l|+finish() cassette_Result\<(), String\>\l}", shape=record];
        "asb-cli_src_collectors_adapters_FlamegraphCollector" [label="{collectors_adapters_FlamegraphCollector}", shape=record];
        "asb-cli_src_collectors_adapters_FlamegraphStatus" [label="{collectors_adapters_FlamegraphStatus|-schema_version: u32\l-status: &'a str\l-artifact: Option\<&'a str\>\l-reason: Option\<&'a str\>\l}", shape=record];
        "asb-cli_src_collectors_adapters_GovernorInfo" [label="{collectors_adapters_GovernorInfo|-names: Vec\<String\>\l-min_khz: Option\<u64\>\l-max_khz: Option\<u64\>\l}", shape=record];
        "asb-cli_src_collectors_adapters_Identity" [label="{collectors_adapters_Identity|-executable: PathBuf\l-interpreter: Option\<PathBuf\>\l-runtime_arguments: Option\<(String, String)\>\l|+resolve(program: &str, args: &[String]) Option\<Self\>\l+resolve_in(program: &str, args: &[String], path: Option\<&std::ffi::OsStr\>, cwd: Option\<&Path\>) Option\<Self\>\l+matches_sample(proc: &Path, admitted: bool) bool\l+matches(proc: &Path) bool\l}", shape=record];
        "asb-cli_src_collectors_adapters_IoState" [label="{collectors_adapters_IoState|-enabled: bool\l}", shape=record];
