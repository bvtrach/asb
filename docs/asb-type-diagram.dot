        "asb-cli_src_collectors_adapters_perfetto_Service" [label="{collectors_adapters_perfetto_Service|+instance: String\l+marker: PathBuf\l-executable: PathBuf\l-producer: String\l-consumer: String\l-children: Arc\<Mutex\<Vec\<Child\>\>\>\l-owner: Option\<collectors_adapters_perfetto_Owner\>\l-_lease: File\l|+acquire(executable: &Path, measurements: &Path) cassette_Result\<Arc\<Self\>, String\>\l+start(executable: &Path, instance: String, marker: PathBuf, lease: File, directory: &Path, namespace_helper: Option\<&Path\>) cassette_Result\<Self, String\>\l+command(applet: &str) Command\l+check_alive() cassette_Result\<(), String\>\l}", shape=record];
