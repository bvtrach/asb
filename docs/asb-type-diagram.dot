        "asb-cli_src_collectors_adapters_Leaf" [label="{collectors_adapters_Leaf|-path: PathBuf\l}", shape=record];
        "asb-cli_src_collectors_adapters_MpstatCollector" [label="{collectors_adapters_MpstatCollector}", shape=record];
        "asb-cli_src_collectors_adapters_NamespaceSample" [label="{collectors_adapters_NamespaceSample|-schema_version: u32\l-identity_available: bool\l-distinct_processes: u64\l-peak_rss_kib: u64\l-samples: u64\l-incomplete: bool\l-sampling_interval_ms: u64\l}", shape=record];
        "asb-cli_src_collectors_adapters_PerfCollector" [label="{collectors_adapters_PerfCollector}", shape=record];
        "asb-cli_src_collectors_adapters_PerfState" [label="{collectors_adapters_PerfState|-enabled: bool\l}", shape=record];
        "asb-cli_src_collectors_adapters_PerfettoCollector" [label="{collectors_adapters_PerfettoCollector}", shape=record];
        "asb-cli_src_collectors_adapters_PerfettoState" [label="{collectors_adapters_PerfettoState|-service: Option\<Arc\<Service\>\>\l-enabled: bool\l-trace: Option\<PathBuf\>\l-pid: Option\<u32\>\l-trace_marker: Option\<PathBuf\>\l-trace_marker_output: Option\<File\>\l-marker_verified: bool\l-marker_warning: Option\<String\>\l-scope_warning: Option\<String\>\l-tracepoint_count: u64\l-metrics: BTreeMap\<String, f64\>\l}", shape=record];
        "asb-cli_src_collectors_adapters_RuntimeCollector" [label="{collectors_adapters_RuntimeCollector}", shape=record];
        "asb-cli_src_collectors_adapters_Sampler" [label="{collectors_adapters_Sampler|-stop: Sender\<()\>\l-thread: Option\<JoinHandle\<Totals\>\>\l|+finish(self) collectors_adapters_Totals\l}", shape=record];
        "asb-cli_src_collectors_adapters_State" [label="{collectors_adapters_State|-leaf: Option\<collectors_adapters_Leaf\>\l-reason: Option\<String\>\l-isolated: bool\l-external: Option\<collectors_adapters_ExternalCounter\>\l-external_reason: Option\<String\>\l}", shape=record];
        "asb-cli_src_collectors_adapters_StateSpan" [label="{collectors_adapters_StateSpan|-tid: u32\l-ts: u64\l-dur: u64\l-state: String\l-io_wait: bool\l}", shape=record];
        "asb-cli_src_collectors_adapters_StepsCollector" [label="{collectors_adapters_StepsCollector}", shape=record];
        "asb-cli_src_collectors_adapters_SuccessRateCollector" [label="{collectors_adapters_SuccessRateCollector}", shape=record];
        "asb-cli_src_collectors_adapters_SystemCollector" [label="{collectors_adapters_SystemCollector}", shape=record];
        "asb-cli_src_collectors_adapters_SystemInfo" [label="{collectors_adapters_SystemInfo|-schema_version: u32\l-collected_unix_ms: u128\l-os: &'static str\l-architecture: &'static str\l-logical_cpus: usize\l-kernel_release: Option\<String\>\l-memory_total_kib: Option\<u64\>\l-cpu_model: Option\<String\>\l-cpu_vendor: Option\<String\>\l-cpu_implementer: Option\<String\>\l-cpu_part: Option\<String\>\l-physical_packages: Option\<usize\>\l-physical_cores: Option\<usize\>\l-threads_per_core: Option\<usize\>\l-cpu_governors: Vec\<String\>\l-cpu_frequency_min_khz: Option\<u64\>\l-cpu_frequency_max_khz: Option\<u64\>\l-numa_nodes: Option\<usize\>\l-virtualization: Option\<String\>\l-container_runtime: Option\<String\>\l-compiler_versions: BTreeMap\<String, String\>\l-runtime_versions: BTreeMap\<String, String\>\l-collector_versions: BTreeMap\<String, String\>\l-kernel_settings: BTreeMap\<String, String\>\l}", shape=record];
        "asb-cli_src_collectors_adapters_TokenUsage" [label="{collectors_adapters_TokenUsage||+merge(self, other: Self) Self\l+add(self, other: Self) Self\l+merge_with_source(self, other: Self, source: &str) Self\l+with_derived_total(self) Self\l+any() bool\l}", shape=record];
