// Futex wait pressure for all threads in the agent process tree.
tracepoint:syscalls:sys_enter_futex /@asb_tree[pid]/ {
  @asb_futex_start[tid] = nsecs;
  @asb_futex_calls = count();
}

tracepoint:syscalls:sys_exit_futex /@asb_futex_start[tid]/ {
  $latency = nsecs - @asb_futex_start[tid];
  @asb_futex_wait_events = count();
  @asb_futex_wait_total_ns = sum($latency);
  @asb_futex_wait_max_ns = max($latency);
  delete(@asb_futex_start[tid]);
}

// Emit cumulative interval samples without clearing the final aggregate maps.
interval:s:1 {
  print(@asb_futex_calls);
  print(@asb_futex_wait_events);
  print(@asb_futex_wait_total_ns);
  print(@asb_futex_wait_max_ns);
}
