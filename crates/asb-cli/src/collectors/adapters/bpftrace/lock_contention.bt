// Kernel lock contention attributable to the agent process tree. This profile
// needs a kernel built with lock contention tracepoints.
tracepoint:lock:contention_begin /@asb_tree[pid] || @asb_tree[tid]/ {
  @asb_lock_start[tid] = nsecs;
}

tracepoint:sched:sched_process_exit /@asb_lock_start[tid]/ {
  delete(@asb_lock_start[tid]);
}

tracepoint:lock:contention_end /@asb_lock_start[tid]/ {
  $latency = nsecs - @asb_lock_start[tid];
  @asb_lock_contention_events = count();
  @asb_lock_contention_total_ns = sum($latency);
  @asb_lock_contention_max_ns = max($latency);
  delete(@asb_lock_start[tid]);
}

// Emit cumulative interval samples without clearing the final aggregate maps.
interval:s:1 {
  printf("ASB_BPFTRACE_SNAPSHOT %llu\n", nsecs(monotonic));
  print(@asb_lock_contention_events);
  print(@asb_lock_contention_total_ns);
  print(@asb_lock_contention_max_ns);
  printf("ASB_BPFTRACE_SNAPSHOT_END\n");
}
