// Agent wakeup-to-run latency across the full process tree.
tracepoint:sched:sched_wakeup /@asb_tree[args->pid]/ {
  @asb_wakeup_start[args->pid] = nsecs;
}

tracepoint:sched:sched_wakeup_new /@asb_tree[args->pid]/ {
  @asb_wakeup_start[args->pid] = nsecs;
}

tracepoint:sched:sched_switch /@asb_wakeup_start[args->next_pid]/ {
  $latency = nsecs - @asb_wakeup_start[args->next_pid];
  @asb_wakeup_latency_events = count();
  @asb_wakeup_latency_total_ns = sum($latency);
  @asb_wakeup_latency_max_ns = max($latency);
  delete(@asb_wakeup_start[args->next_pid]);
}

// Do not retain an unfinished timing entry across TID reuse.
tracepoint:sched:sched_process_exit /@asb_wakeup_start[tid]/ {
  delete(@asb_wakeup_start[tid]);
}

// Emit cumulative interval samples without clearing the final aggregate maps.
interval:s:1 {
  print(@asb_wakeup_latency_events);
  print(@asb_wakeup_latency_total_ns);
  print(@asb_wakeup_latency_max_ns);
}
